# Copy to .env and fill in. .env is git-ignored.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
# All agents (departments, coordinator, radio intake) use Gemini 3.6 Flash:
GEMINI_PRO_MODEL=gemini-2.5-flash
GEMINI_LITE_MODEL=gemini-2.5-flash
# Set to 1 to force offline stub mode even with a project set:
EMERFLOW_STUB=0
